<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.SourceManager</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.SourceManager</RootNamespace>
    <Version>1.0.10.0</Version>
    <Authors>Jellystrm</Authors>
    <RepositoryUrl>https://github.com/jellystrm/source-manager</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>$(NoWarn);CS1591;SA1600;SA1601;SA1633</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Jellyfin already loads Microsoft.Data.Sqlite + SQLitePCLRaw and inits
         the provider process-wide. Compile against it but do NOT ship it:
         bundling the native runtimes/ tree makes Jellyfin's assembly scanner
         throw BadImageFormatException on the native e_sqlite3 libs and
         disable the whole plugin ("Malfunctioned"). -->
    <PackageReference Include="Microsoft.Data.Sqlite">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Belt-and-suspenders: even with ExcludeAssets, the SQLitePCLRaw native
       bundle can stage runtimes/<rid>/native/e_sqlite3.* into publish output.
       Jellyfin's plugin loader scans every file and throws
       BadImageFormatException on these native libs, disabling the plugin.
       Jellyfin already provides SQLite at runtime, so strip the tree. -->
  <Target Name="StripNativeRuntimes" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes" />
  </Target>

  <ItemGroup>
    <None Remove="Pages\**\*" />
    <EmbeddedResource Include="Pages\**\*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\MediaBrowser.Controller\MediaBrowser.Controller.csproj')">
    <ProjectReference Include="..\..\Jellyfin.Data\Jellyfin.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\MediaBrowser.Controller\MediaBrowser.Controller.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\MediaBrowser.Model\MediaBrowser.Model.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\MediaBrowser.Common\MediaBrowser.Common.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\..\MediaBrowser.Controller\MediaBrowser.Controller.csproj')">
    <PackageReference Include="Jellyfin.Controller">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Common">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
